# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- DagsHub / MLflow (Task 3) ---
DAGSHUB_USER=your_dagshub_username
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/23L0839_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token
MLFLOW_DISABLE_AGENT_HINT=1

# --- Docker Compose (Task 6) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visionguard
INFERENCE_MODE=local          # local = model inside the web container, remote = call the cloud API
THRESHOLD=0.5                 # decision threshold chosen on validation data (see report 2.5)
MODEL_VERSION=champion

# --- Remote model API (Tasks 7/8) ---
MODEL_API_URL=https://<your-cloud-url>
MODEL_API_KEY=change_me
